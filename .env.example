# Database (Required)
DB_URL="postgres://postgres:postgres@localhost:5432/malfestio_dev?sslmode=disable"

# OAuth Client Configuration (Optional - defaults shown)
APP_URL=http://127.0.0.1:3000
APP_NAME=Malfestio

# Server Configuration (Optional - defaults shown)
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Frontend Configuration (Optional - defaults shown)
VITE_API_URL=http://localhost:8080

# Logging (Optional)
RUST_LOG=info,malfestio_server=debug
