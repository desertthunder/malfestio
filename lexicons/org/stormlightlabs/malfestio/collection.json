{
  "lexicon": 1,
  "id": "org.stormlightlabs.malfestio.collection",
  "defs": {
    "main": {
      "type": "record",
      "description": "A curated collection or learning path.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["title", "createdAt"],
        "properties": {
          "title": { "type": "string", "maxLength": 300 },
          "description": { "type": "string", "maxLength": 3000 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "ref"],
              "properties": {
                "type": { "type": "string", "maxLength": 100, "knownValues": ["deck", "note", "article", "lecture"] },
                "ref": { "type": "string", "format": "at-uri" },
                "note": { "type": "string", "maxLength": 1000, "description": "Curator's note about this item." }
              }
            },
            "description": "Ordered items in the collection."
          },
          "tags": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "maxLength": 64 },
          "visibility": {
            "type": "string",
            "maxLength": 100,
            "knownValues": ["private", "unlisted", "public"],
            "default": "public",
            "description": "Visibility setting for the collection."
          },
          "language": {
            "type": "string",
            "maxLength": 20,
            "description": "Language code for the collection content (e.g., 'en', 'es', 'fr')."
          },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime", "description": "Timestamp of last update." }
        }
      }
    }
  }
}
